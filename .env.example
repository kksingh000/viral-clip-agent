# =============================================================================
# Viral Clip Agent -- example environment
#
# Copy to .env and fill in. Never commit a real .env.
# The application starts with NO credentials at all: it runs in a degraded but
# honest mode (deterministic agent fallbacks, structural-only transcripts) and
# reports that state on GET /health.
# =============================================================================

# --------------------------------------------------------------------- general
ENVIRONMENT=local                 # local | development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------------ auth
# REQUIRED in staging/production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank locally, an ephemeral key is generated at startup, so tokens do
# not survive a restart.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOW_REGISTRATION=true

# -------------------------------------------------------------------- database
# Docker Compose default:
DATABASE_URL=postgresql+asyncpg://viralagent:viralagent@postgres:5432/viralagent
# Local development without a database server:
# DATABASE_URL=sqlite+aiosqlite:///./data/viralagent.db
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------- queue/cache
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# Run tasks inline instead of queueing them. Development and CI only.
CELERY_TASK_ALWAYS_EAGER=false

# -------------------------------------------------------------------- storage
STORAGE_PROVIDER=local            # local | s3
STORAGE_LOCAL_ROOT=./data/storage
# Base URL the API serves signed local media from. Must match how the browser
# reaches the API.
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
SIGNED_URL_TTL_SECONDS=3600
# S3 / MinIO / R2 (required when STORAGE_PROVIDER=s3)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- AI providers
# anthropic | openai | mock
# "mock" means NO model is called: every agent uses its deterministic fallback
# and says so in the job warnings. Nothing is fabricated.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=180
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                # for an OpenAI-compatible endpoint

# --------------------------------------------------------------- transcription
# faster_whisper (on-box) | openai (hosted) | mock
# "mock" reads a <media>.transcript.json sidecar if present, otherwise emits
# real segment timings with placeholder words and flags them as synthetic.
TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL_SIZE=base           # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto               # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8         # int8 | int8_float16 | float16 | float32
# Leave blank to auto-detect the language (recommended for Hindi/Hinglish).
TRANSCRIPTION_DEFAULT_LANGUAGE=

# --------------------------------------------------------------------- vision
VISION_PROVIDER=opencv            # opencv | mock

# ---------------------------------------------------------- trend discovery
# Official YouTube Data API v3 key. Discovery reads public METADATA ONLY and
# never downloads media; without this key the discovery endpoints are disabled.
# YOUTUBE_API_KEY=

# ---------------------------------------------------------------------- media
# Leave blank to use the system ffmpeg, falling back to the imageio-ffmpeg
# wheel. The worker image installs a full ffmpeg + ffprobe.
# FFMPEG_PATH=
# FFPROBE_PATH=
WORKDIR=./data/work
MAX_UPLOAD_BYTES=4294967296       # 4 GiB
FFMPEG_TIMEOUT_SECONDS=3600
VIDEO_ENCODE_PRESET=medium        # ultrafast..veryslow
VIDEO_ENCODE_CRF=18               # lower is higher quality

# --------------------------------------------------------------------- limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
# Comma separated. localhost and 127.0.0.1 are distinct origins to a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------- pipeline
MAX_CANDIDATES_PER_VIDEO=12
DEFAULT_CLIPS_PER_VIDEO=3
TRANSCRIPT_CHUNK_CHARS=14000

# ------------------------------------------------------------------- frontend
# Read by the Next.js app at build and run time.
NEXT_PUBLIC_API_URL=http://localhost:8000
